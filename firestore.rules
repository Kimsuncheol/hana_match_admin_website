// NOT DEPLOYED. This is a reference/starting point, not the live ruleset.
//
// hana-match's Firestore already serves an existing app under its own
// rules (currently: any signed-in user may read/write everything). This
// reference defines the collections owned by the admin site; merge these
// collection blocks into the live ruleset rather than deploying this file
// wholesale.
//
// adminProfiles itself is safe regardless: it's only ever written by the
// Admin SDK (lib/firebase-admin/assign-role.ts), which bypasses rules
// entirely, and the actual access gate for this Next.js app is the
// `admin` custom claim checked in components/auth/protected-route.tsx and
// app/api/admin/assign-role/route.ts, not these rules.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Profile doc written by /api/admin/assign-role. Admins may read it;
    // nobody (including the owning user) may write to it directly, since
    // role/admin status must only ever change via that trusted server-side
    // flow.
    match /adminProfiles/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // All moderation writes go through the privileged `moderateCase`
    // Cloud Function. Admin SDK writes bypass rules; browser writes do not.
    match /moderationCases/{caseId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Immutable from every client, including an authenticated admin.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /humanReviewRequests/{requestId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /moderationEffects/{effectId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /userModerationStates/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Policy reads and writes must use superAdmin-authorized callable
    // functions. Versions and audit records are immutable to every client.
    match /policySettings/{documentId} {
      allow read, write: if false;
    }

    match /policyVersions/{versionId} {
      allow read, write: if false;
    }

    // Model telemetry may contain provider/internal fields. Only aggregate
    // server DTOs are exposed; rollout changes use an audited callable.
    match /moderationReviewOutcomes/{outcomeId} {
      allow read, write: if false;
    }

    match /aiLatencyLogs/{logId} {
      allow read, write: if false;
    }

    match /modelDeployments/{deploymentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      // Fail closed for any collection not explicitly listed above. Firestore
      // combines overlapping match statements with OR, so a broad admin read
      // here would otherwise bypass the callable-only policy collection rule.
      allow read, write: if false;
    }
  }
}
