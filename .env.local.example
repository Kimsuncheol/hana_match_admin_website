# Firebase client config (safe to expose to the browser — these are not secrets).
# Copy this file to .env.local and fill in values from the Firebase console:
# Project settings > General > Your apps > SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: restrict which email domains get the default admin role.
# Comma-separated, no leading "@". Enforced server-side only, in
# app/api/admin/assign-role/route.ts — never trust a client-side check.
# Leave unset to grant every successfully created account the admin role.
# Example: hanamatch.com,partner-hanamatch.jp
ADMIN_ALLOWED_EMAIL_DOMAINS=

# Server-only: a Firebase service account with the "Firebase Authentication
# Admin" role, used by lib/firebase-admin/server.ts to verify ID tokens and
# set custom claims. Never prefix these with NEXT_PUBLIC_.
# Create one: Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
